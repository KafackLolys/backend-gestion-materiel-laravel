{
    "openapi": "3.0.0",
    "info": {
        "title": "API Gestion Matériel",
        "description": "Documentation de l'API pour l'application de gestion de matériel",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion utilisateur",
                "description": "Permet de connecter un utilisateur",
                "operationId": "loginUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie"
                    },
                    "401": {
                        "description": "Identifiants invalides"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Déconnexion utilisateur",
                "description": "Permet de déconnecter un utilisateur",
                "operationId": "logoutUser",
                "responses": {
                    "200": {
                        "description": "Déconnexion réussie"
                    }
                }
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Inscription utilisateur",
                "description": "Crée un nouveau compte utilisateur et retourne un token",
                "operationId": "registerUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "email",
                                    "password",
                                    "role"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "John"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "student_delegate"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Utilisateur créé avec succès"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
        "/api/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Récupérer le profil courant",
                "description": "Retourne les informations de l'utilisateur connecté",
                "operationId": "getMe",
                "responses": {
                    "200": {
                        "description": "Profil de l'utilisateur"
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                }
            },
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Mettre à jour son profil",
                "description": "Modifie les informations de l'utilisateur connecté",
                "operationId": "updateMe",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": { "type": "string", "example": "Jane" },
                                    "last_name": { "type": "string", "example": "Doe" },
                                    "email": { "type": "string", "format": "email", "example": "jane@example.com" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profil mis à jour"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Auth"
                ],
                "summary": "Supprimer son compte",
                "description": "Supprime le compte de l'utilisateur connecté",
                "operationId": "deleteMe",
                "responses": {
                    "200": {
                        "description": "Compte supprimé avec succès"
                    }
                }
            }
        },
        "/api/user/profile": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Mettre à jour le profil utilisateur",
                "description": "Met à jour le profil de l'utilisateur connecté via /api/user/profile",
                "operationId": "updateUserProfile",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": { "type": "string" },
                                    "last_name": { "type": "string" },
                                    "email": { "type": "string", "format": "email" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profil mis à jour"
                    }
                }
            }
        },
        "/api/user/password": {
            "put": {
                "tags": [
                    "Users"
                ],
                "summary": "Changer le mot de passe",
                "description": "Change le mot de passe de l'utilisateur connecté",
                "operationId": "updatePassword",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "new_password",
                                    "new_password_confirmation"
                                ],
                                "properties": {
                                    "current_password": { "type": "string", "example": "oldSecret123" },
                                    "new_password": { "type": "string", "example": "newSecret123" },
                                    "new_password_confirmation": { "type": "string", "example": "newSecret123" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Mot de passe mis à jour" },
                    "422": { "description": "Erreur de validation" }
                }
            }
        },
        "/api/user/image_profile": {
            "post": {
                "tags": [
                    "Users"
                ],
                "summary": "Mettre à jour l'image de profil",
                "description": "Upload une nouvelle image de profil pour l'utilisateur connecté",
                "operationId": "updateImageProfile",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "required": ["image_profil"],
                                "properties": {
                                    "image_profil": { "type": "string", "format": "binary" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Image mise à jour avec succès" },
                    "422": { "description": "Erreur de validation" }
                }
            }
        },
        "/api/users": {
            "get": {
                "tags": ["Users"],
                "summary": "Lister les utilisateurs",
                "description": "Récupère la liste des utilisateurs",
                "operationId": "getUsers",
                "responses": {
                    "200": { "description": "Liste des utilisateurs" },
                    "401": { "description": "Non authentifié" },
                    "403": { "description": "Accès refusé" }
                }
            },
            "post": {
                "tags": ["Users"],
                "summary": "Créer un utilisateur",
                "description": "Ajoute un nouvel utilisateur",
                "operationId": "createUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["first_name", "last_name", "email", "password", "role"],
                                "properties": {
                                    "first_name": { "type": "string" },
                                    "last_name": { "type": "string" },
                                    "email": { "type": "string", "format": "email" },
                                    "password": { "type": "string" },
                                    "role": { "type": "string" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Utilisateur créé" },
                    "422": { "description": "Erreur de validation" }
                }
            }
        },
        "/api/users/{id}": {
            "get": {
                "tags": ["Users"],
                "summary": "Détails d'un utilisateur",
                "description": "Affiche un utilisateur par son ID",
                "operationId": "getUserById",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Utilisateur trouvé" },
                    "404": { "description": "Utilisateur introuvable" }
                }
            },
            "put": {
                "tags": ["Users"],
                "summary": "Mettre à jour un utilisateur",
                "description": "Modifie un utilisateur existant",
                "operationId": "updateUser",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": { "type": "string" },
                                    "last_name": { "type": "string" },
                                    "email": { "type": "string", "format": "email" },
                                    "role": { "type": "string" }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Utilisateur mis à jour" },
                    "404": { "description": "Utilisateur introuvable" }
                }
            },
            "delete": {
                "tags": ["Users"],
                "summary": "Supprimer un utilisateur",
                "description": "Supprime un utilisateur par ID",
                "operationId": "deleteUser",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Utilisateur supprimé" },
                    "404": { "description": "Utilisateur introuvable" }
                }
            }
        },
        "/api/projectors": {
            "get": {
                "tags": ["Projectors"],
                "summary": "Lister les projecteurs",
                "description": "Récupère la liste des projecteurs",
                "operationId": "getProjectors",
                "responses": {
                    "200": { "description": "Liste des projecteurs retournée" },
                    "500": { "description": "Erreur serveur" }
                }
            },
            "post": {
                "tags": ["Projectors"],
                "summary": "Créer un projecteur",
                "description": "Ajoute un nouveau projecteur",
                "operationId": "createProjector",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": ["marque", "etat"],
                                "type": "object",
                                "properties": {
                                    "marque": { "type": "string" },
                                    "description": { "type": "string" },
                                    "etat": { "type": "string", "enum": ["disponible", "emprunte", "en_maintenance", "hors_service"] },
                                    "image": { "type": "string", "format": "binary" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Projecteur créé" },
                    "422": { "description": "Erreur de validation" }
                }
            }
        },
        "/api/projectors/{id}": {
            "get": {
                "tags": ["Projectors"],
                "summary": "Détails d'un projecteur",
                "description": "Affiche un projecteur spécifique",
                "operationId": "getProjectorById",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Projecteur trouvé" },
                    "404": { "description": "Projecteur introuvable" }
                }
            },
            "put": {
                "tags": ["Projectors"],
                "summary": "Mettre à jour un projecteur",
                "description": "Modifie un projecteur existant",
                "operationId": "updateProjector",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "marque": { "type": "string" },
                                    "description": { "type": "string" },
                                    "etat": { "type": "string", "enum": ["disponible", "emprunte", "en_maintenance", "hors_service"] },
                                    "image": { "type": "string", "format": "binary" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Projecteur mis à jour" },
                    "404": { "description": "Projecteur introuvable" }
                }
            },
            "delete": {
                "tags": ["Projectors"],
                "summary": "Supprimer un projecteur",
                "description": "Supprime un projecteur existant",
                "operationId": "deleteProjector",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Projecteur supprimé" },
                    "404": { "description": "Projecteur introuvable" }
                }
            }
        },
        "/api/accessories": {
            "get": {
                "tags": ["Accessories"],
                "summary": "Lister les accessoires",
                "description": "Récupère la liste des accessoires",
                "operationId": "getAccessories",
                "responses": {
                    "200": { "description": "Liste des accessoires retournée" },
                    "500": { "description": "Erreur serveur" }
                }
            },
            "post": {
                "tags": ["Accessories"],
                "summary": "Créer un accessoire",
                "description": "Ajoute un nouvel accessoire",
                "operationId": "createAccessory",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": ["name", "quantity"],
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "quantity": { "type": "integer" },
                                    "description": { "type": "string" },
                                    "image": { "type": "string", "format": "binary" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Accessoire créé" },
                    "422": { "description": "Erreur de validation" }
                }
            }
        },
        "/api/accessories/{id}": {
            "get": {
                "tags": ["Accessories"],
                "summary": "Détails d'un accessoire",
                "description": "Affiche un accessoire spécifique",
                "operationId": "getAccessoryById",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Accessoire trouvé" },
                    "404": { "description": "Accessoire introuvable" }
                }
            },
            "put": {
                "tags": ["Accessories"],
                "summary": "Mettre à jour un accessoire",
                "description": "Modifie un accessoire existant",
                "operationId": "updateAccessory",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "quantity": { "type": "integer" },
                                    "description": { "type": "string" },
                                    "image": { "type": "string", "format": "binary" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Accessoire mis à jour" },
                    "404": { "description": "Accessoire introuvable" }
                }
            },
            "delete": {
                "tags": ["Accessories"],
                "summary": "Supprimer un accessoire",
                "description": "Supprime un accessoire existant",
                "operationId": "deleteAccessory",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Accessoire supprimé" },
                    "404": { "description": "Accessoire introuvable" }
                }
            }
        },
        "/api/stats": {
            "get": {
                "tags": ["Stats"],
                "summary": "Récupérer les statistiques",
                "description": "Retourne les statistiques globales de l'application",
                "operationId": "getStats",
                "responses": {
                    "200": { "description": "Statistiques récupérées avec succès" },
                    "500": { "description": "Erreur serveur" }
                }
            }
        },
        "/api/loans": {
            "get": {
                "tags": ["Loans"],
                "summary": "Lister les emprunts",
                "description": "Récupère la liste des emprunts",
                "operationId": "getLoans",
                "responses": {
                    "200": { "description": "Liste des emprunts retournée" },
                    "401": { "description": "Non authentifié" }
                }
            },
            "post": {
                "tags": ["Loans"],
                "summary": "Créer un emprunt",
                "description": "Crée un nouvel emprunt",
                "operationId": "createLoan",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["loan_date", "cni_number"],
                                "type": "object",
                                "properties": {
                                    "projector_id": { "type": "integer" },
                                    "loan_date": { "type": "string", "format": "date", "example": "2026-05-21" },
                                    "return_date": { "type": "string", "format": "date", "example": "2026-05-25" },
                                    "classroom": { "type": "string", "example": "Salle 101" },
                                    "room": { "type": "string", "example": "B1" },
                                    "cni_number": { "type": "string", "example": "123456789" },
                                    "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
                                    "starting_state": { "type": "string" },
                                    "ending_state": { "type": "string" },
                                    "teacher_name": { "type": "string", "example": "M. Dupont" },
                                    "accessories": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "accessory_id": { "type": "integer" },
                                                "quantity": { "type": "integer" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Emprunt créé" },
                    "422": { "description": "Erreur de validation" },
                    "500": { "description": "Erreur serveur" }
                }
            }
        },
        "/api/loans/{id}": {
            "get": {
                "tags": ["Loans"],
                "summary": "Détails d'un emprunt",
                "description": "Affiche les détails d'un emprunt",
                "operationId": "getLoanById",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Emprunt trouvé" },
                    "404": { "description": "Emprunt introuvable" },
                    "403": { "description": "Accès refusé" }
                }
            },
            "put": {
                "tags": ["Loans"],
                "summary": "Mettre à jour un emprunt",
                "description": "Met à jour un emprunt existant",
                "operationId": "updateLoan",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "projector_id": { "type": "integer" },
                                    "loan_date": { "type": "string", "format": "date" },
                                    "return_date": { "type": "string", "format": "date" },
                                    "classroom": { "type": "string" },
                                    "room": { "type": "string" },
                                    "cni_number": { "type": "string" },
                                    "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
                                    "starting_state": { "type": "string" },
                                    "ending_state": { "type": "string" },
                                    "teacher_name": { "type": "string" },
                                    "accessories": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "accessory_id": { "type": "integer" },
                                                "quantity": { "type": "integer" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Emprunt mis à jour" },
                    "404": { "description": "Emprunt introuvable" },
                    "403": { "description": "Accès refusé" }
                }
            },
            "delete": {
                "tags": ["Loans"],
                "summary": "Supprimer un emprunt",
                "description": "Supprime un emprunt existant",
                "operationId": "deleteLoan",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
                ],
                "responses": {
                    "200": { "description": "Emprunt supprimé" },
                    "404": { "description": "Emprunt introuvable" },
                    "403": { "description": "Accès refusé" }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Users",
            "description": "Gestion des utilisateurs"
        },
        {
            "name": "Projectors",
            "description": "Gestion des projecteurs"
        },
        {
            "name": "Accessories",
            "description": "Gestion des accessoires"
        },
        {
            "name": "Loans",
            "description": "Gestion des emprunts"
        },
        {
            "name": "Stats",
            "description": "Statistiques de l'application"
        }
    ]
}